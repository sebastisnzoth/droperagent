{
  "name": "droperagent",
  "version": "1.0.0",
  "description": "Agente de automatização para Dropshipping WooCommerce - Controlado por DeepSeek Harness",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "build": "mkdir -p dist && npx tsc",
    "docker-build": "docker build -t autodrop-mcp .",
    "health": "curl -s http://localhost:3000/health | jq"
  },
  "keywords": [
    "agent",
    "automation",
    "dropshipping",
    "woocommerce",
    "dsers",
    "ai",
    "harness",
    "mcp"
  ],
  "author": "sebastisnzoth",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "woocommerce-rest-api": "^3.0.0",
    "axios": "^1.6.7",
    "winston": "^3.11.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
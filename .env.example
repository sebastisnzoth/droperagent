# DroperAgent Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# WooCommerce API
WOOCOMMERCE_URL=http://localhost:8080
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# DSers API (when available)
DSERS_API_KEY=your_dsers_api_key

# Database (for local development)
DATABASE_URL=sqlite:./data/droperagent.db

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
JWT_SECRET=your_jwt_secret_key
API_RATE_LIMIT=100
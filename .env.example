# DroperAgent — development-only template, never commit .env
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Generate a unique long administrator password in your secret manager.
# Required to enable browser login. Do NOT put it in web/VITE_*.
DROPERAGENT_ADMIN_PASSWORD=
# Optional long CLI-only token for local tools; never publish in frontend.
DROPERAGENT_API_TOKEN=
# Exact public frontend Origin allowed by API CORS
DROPERAGENT_WEB_ORIGIN=https://sebastisnzoth.github.io
# Set only when running behind a trusted reverse proxy that provides X-Forwarded-Proto
TRUST_PROXY=0
# Disable worker when using ephemeral hosting without persistent disk
DROPERAGENT_DISABLE_WORKER=0

# WooCommerce REST API credentials from an owned development store
# HTTPS is required except loopback development
WOOCOMMERCE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# MCP draft writes disabled by default
DROPERAGENT_MCP_ALLOW_DRAFTS=0

# Docker Compose WordPress/MariaDB sandbox (requires Docker runtime)
DB_PASSWORD=
DB_ROOT_PASSWORD=
